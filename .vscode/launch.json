{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bot: dry run (20 iterations)",
      "type": "debugpy",
      "request": "launch",
      "module": "tradebot.cli.main",
      "args": ["--dry-run", "--iterations", "20", "--log-level", "DEBUG"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Bot: dry run (until stopped)",
      "type": "debugpy",
      "request": "launch",
      "module": "tradebot.cli.main",
      "args": ["--dry-run"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Bot: doctor (checks config + connection)",
      "type": "debugpy",
      "request": "launch",
      "module": "tradebot.cli.main",
      "args": ["--dry-run", "--doctor"],
      "console": "integratedTerminal"
    },
    {
      "name": "Bot: TESTNET live orders",
      "type": "debugpy",
      "request": "launch",
      "module": "tradebot.cli.main",
      "args": ["--live", "--config", "config/config.yaml"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: everything (offline)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
