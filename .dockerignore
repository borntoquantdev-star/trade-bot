# Everything the image does not need. Keeps the build small and keeps
# anything local - including a config with real keys - out of it.
.venv/
.git/
.github/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.egg-info/
board/
dashboard/
docs/
tests/
ai/
tools/
logs/
data/
config/config.yaml
*.md
!README.md
